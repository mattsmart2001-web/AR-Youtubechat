{
  "name": "ar-youtubechat",
  "version": "2.0.0",
  "description": "YouTube Live Chat reader for Even Realities G2 glasses via Even Hub",
  "scripts": {
    "dev:server": "ts-node --project tsconfig.server.json server/index.ts",
    "dev:frontend": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "build": "vite build",
    "pack": "evenhub pack app.json ./dist --output ar-ytchat.ehpk",
    "bundle": "npm run build && npm run pack",
    "start": "NODE_ENV=production ts-node --project tsconfig.server.json server/index.ts",
    "auth": "ts-node --project tsconfig.server.json server/auth.ts"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vite": "^5.0.0"
  }
}
