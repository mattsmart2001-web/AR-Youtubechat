# YouTube OAuth 2.0 credentials (from Google Cloud Console)
# Redirect URI to register: http://localhost:3001/callback
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# MentraOS app credentials (from console.mentra.glass)
MENTRAOS_API_KEY=your_mentraos_api_key_here
MENTRAOS_PACKAGE_NAME=com.yourname.ytchat

# Port for the MentraOS app server (default: 3000)
PORT=3000
