# YouTube OAuth 2.0 credentials (from Google Cloud Console)
# Redirect URI to register: http://localhost:3001/callback
YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here

# Port for the Express backend server (default: 3001)
PORT=3001

# For production (.ehpk build): set this to your machine's local IP or ngrok URL
# so the packaged app can reach the Express backend.
# Example: VITE_BACKEND_URL=http://192.168.1.42:3001
# Example: VITE_BACKEND_URL=https://xxxx.ngrok.io
# Leave blank for local dev (Vite proxy handles it automatically)
VITE_BACKEND_URL=
